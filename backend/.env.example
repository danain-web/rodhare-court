# =====================================================================
# Backend Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าที่แท้จริง (ห้าม commit .env ขึ้น Git)
# =====================================================================

PORT=5000
NODE_ENV=development

# =====================================================================
# PostgreSQL (Supabase)
# วิธีหาค่า: Supabase Dashboard → Settings → Database → Connection string
# เลือก "Transaction" mode (port 6543) สำหรับ Render free tier
# =====================================================================
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# =====================================================================
# Supabase Storage (สำหรับเก็บสลิปชำระเงิน)
# วิธีหาค่า: Supabase Dashboard → Settings → API
# SUPABASE_URL       = Project URL (https://xxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY = service_role key (ห้าม expose ให้ Frontend)
# SUPABASE_BUCKET_NAME = ชื่อ bucket ที่สร้างใน Supabase Storage (ตั้งเป็น public)
# =====================================================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx
SUPABASE_BUCKET_NAME=slips

# =====================================================================
# JWT + Cookie
# JWT_SECRET: สุ่มอักขระ 32+ ตัว (เปลี่ยนเป็นค่าจริงก่อน deploy)
# JWT_EXPIRES_IN: อายุ Token (8h = 8 ชั่วโมง)
# FRONTEND_URL: URL ของ Frontend สำหรับตั้งค่า CORS (คั่นหลายค่าด้วย , ได้)
# TRUST_PROXY: จำนวน proxy หน้า Express → local = 0, Render = 1, Vercel rewrite → Render = 2
# =====================================================================
JWT_SECRET=change_me_to_a_very_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=0

# Background job interval (ms) - ตรวจการจองหมดอายุ BR3
MAINTENANCE_INTERVAL_MS=60000

# =====================================================================
# Backend Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (ห้าม commit .env ขึ้น Git)
# ระบบตรวจค่าตอนเริ่มทำงาน (config/env.ts → validateConfig) ถ้าค่าหาย/ผิดรูปแบบ/ไม่ปลอดภัย จะไม่ยอม start
# =====================================================================

PORT=5000
# development | production | test
NODE_ENV=development

# =====================================================================
# PostgreSQL (Supabase)
# Supabase Dashboard → Connect → "Transaction pooler" (port 6543)
# DATABASE_SSL=false ใช้เฉพาะฐานข้อมูลในเครื่องที่ไม่มี SSL (production ห้ามปิด)
# =====================================================================
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# =====================================================================
# Supabase Storage (สลิปชำระเงิน — bucket ต้องเป็น PRIVATE)
# Supabase Dashboard → Project Settings → API
#   SUPABASE_SERVICE_ROLE_KEY = service_role key (ลับ ห้ามส่งไปฝั่ง Frontend)
# SLIP_SIGNED_URL_TTL = อายุลิงก์ดูสลิป (วินาที) ที่ออกให้เจ้าของการจอง/เจ้าหน้าที่
# =====================================================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=slips
SLIP_SIGNED_URL_TTL=300

# =====================================================================
# JWT + Cookie
# JWT_SECRET: อย่างน้อย 32 ตัวอักษร สุ่มด้วยคำสั่ง
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# COOKIE_SAMESITE: lax (ค่าแนะนำ — Frontend เรียก API ผ่าน Vercel rewrite โดเมนเดียวกัน)
# FRONTEND_URL: origin ของหน้าเว็บ (ใช้ทั้ง CORS และตรวจ CSRF) คั่นหลายค่าด้วย , · production ต้องเป็น https
# TRUST_PROXY: จำนวน proxy หน้า Express → local = 0, Render = 1, Vercel rewrite → Render = 2
# =====================================================================
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=0

# =====================================================================
# บัญชีรับเงินจริงของสนาม (แสดงในหน้าชำระเงิน + สร้าง PromptPay QR พร้อมยอด)
# เว้นว่าง = หน้าเว็บแจ้งให้ติดต่อเจ้าหน้าที่ (ระบบไม่แสดงบัญชีสมมติ)
# PAYMENT_PROMPTPAY_ID: เบอร์มือถือ 10 หลัก / เลขบัตรหรือเลขผู้เสียภาษี 13 หลัก / e-Wallet 15 หลัก
# =====================================================================
PAYMENT_ACCOUNT_NAME=
PAYMENT_PROMPTPAY_ID=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT_NO=

# =====================================================================
# Rate limit (ต่อ 15 นาที) — ไม่ตั้ง = ใช้ค่าเริ่มต้น
# =====================================================================
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_BOOKING_MAX=30
RATE_LIMIT_PAYMENT_MAX=10

# Background job interval (ms) — ยกเลิกการจองที่ไม่ชำระภายในเวลาที่กำหนด
MAINTENANCE_INTERVAL_MS=60000
